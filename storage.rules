rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Anexos, imagens e assinaturas digitais das tarefas
    match /tasks/{taskId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024; // Máximo 15MB por arquivo
    }
  }
}
